# E.D.I.T.H. Backend Environment Configuration Example
PORT=4000
NODE_ENV=development

# Allowed CORS origins (comma-separated or * to allow all)
# In production on Render, set this to your Vercel deployment URL (e.g. https://your-project.vercel.app) or *
CLIENT_ORIGIN=http://localhost:5173,*


# Runtime Guard enforcement mode: monitor | protect | strict (default strict). Switchable at runtime via PATCH /api/guard/mode
RUNTIME_GUARD_MODE=strict
